#!/usr/bin/env bash
# Remove the block ./setup added to ~/.config/hypr/bindings.lua. Safe to run again.
set -euo pipefail

ID=a-b.other-monitor-workspaces
BINDINGS=$HOME/.config/hypr/bindings.lua
BEGIN="-- >>> $ID >>>"
END="-- <<< $ID <<<"

fail() { echo "teardown: $*" >&2; exit 1; }

if [[ ! -f $BINDINGS ]] || ! grep -qxF -- "$BEGIN" "$BINDINGS"; then
  echo "Nothing to remove."
  exit 0
fi
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
# awk exits 1 when a block never closes, so a missing or misplaced end marker cannot cost the rest of the file.
awk -v begin="$BEGIN" -v end="$END" '
  $0 == begin { skip = 1; next }
  skip && $0 == end { skip = 0; next }
  !skip
  END { exit skip }
' "$BINDINGS" >"$tmp" || fail "found '$BEGIN' without a following '$END' in $BINDINGS; remove the block by hand"

backup=$(mktemp "$BINDINGS.bak.XXXXXX")
cp "$BINDINGS" "$backup"
# Write through rather than mv, so a symlinked bindings.lua (dotfile managers) and its permissions survive.
cat "$tmp" >"$BINDINGS"

if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] && command -v hyprctl >/dev/null; then
  hyprctl reload >/dev/null || echo "teardown: could not reach Hyprland; run: hyprctl reload" >&2
fi

echo "Removed the Other Monitor Workspaces block from $BINDINGS (backup: $backup)."
echo "Remove the plugin itself with: omarchy plugin remove $ID"
